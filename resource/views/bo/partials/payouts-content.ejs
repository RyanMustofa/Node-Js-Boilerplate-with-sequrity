<section class="page-heading"><div><h1>Payouts</h1><p>Kelola dan pantau pencairan dana pengguna.</p></div><button class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Buat payout</button></section>
<section class="row g-3 mb-4">
  <div class="col-12 col-md-4"><div class="stat-card"><div class="stat-label mt-0">Total payout hari ini</div><div class="stat-value">Rp 62,7 jt</div><div class="stat-foot">5 payout pada data demo</div></div></div>
  <div class="col-12 col-md-4"><div class="stat-card"><div class="stat-label mt-0">Dalam antrean</div><div class="stat-value">18</div><div class="stat-foot"><span class="text-warning fw-semibold">Perlu diproses</span></div></div></div>
  <div class="col-12 col-md-4"><div class="stat-card"><div class="stat-label mt-0">Berhasil bulan ini</div><div class="stat-value">1.204</div><div class="stat-foot"><span class="text-success fw-semibold">98,4% success rate</span></div></div></div>
</section>
<section class="panel">
  <div class="panel-header flex-wrap gap-3"><div><h2>Riwayat payout</h2><span class="small text-muted-custom"><%= payouts.length %> payout terbaru · sesuai struktur tabel payouts</span></div><div class="d-flex flex-wrap gap-2"><div class="input-group search-control"><span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-secondary"></i></span><input class="form-control border-start-0" type="search" placeholder="Cari reference..." aria-label="Cari payout"></div><select class="form-select status-filter" aria-label="Filter status"><option>Semua status</option><option>queued</option><option>processing</option><option>completed</option><option>failed</option></select></div></div>
  <div class="table-responsive"><table class="table"><thead><tr><th>Payout</th><th>User ID</th><th>Reference ID</th><th>Waktu dibuat</th><th>Nominal</th><th>Status</th><th></th></tr></thead><tbody><% payouts.forEach((item) => { %><tr><td><span class="fw-semibold text-dark">#<%= item.id %></span></td><td><span class="badge text-bg-light border text-secondary"><%= item.userId %></span></td><td class="fw-medium text-dark"><%= item.referenceId %></td><td><%= item.createdAt %></td><td class="fw-semibold text-dark"><%= item.amountDisplay %></td><td><span class="badge-soft bg-<%= item.statusClass %>-subtle text-<%= item.statusClass %>-emphasis"><%= item.status %></span></td><td><button class="btn btn-sm btn-light border" type="button" aria-label="Detail payout <%= item.id %>"><i class="bi bi-three-dots"></i></button></td></tr><% }) %></tbody></table></div>
  <div class="d-flex justify-content-between align-items-center px-3 py-3 border-top"><span class="small text-muted-custom">Menampilkan <%= payouts.length %> data demo</span><nav aria-label="Navigasi halaman"><ul class="pagination pagination-sm mb-0"><li class="page-item disabled"><a class="page-link" href="#" tabindex="-1">‹</a></li><li class="page-item active"><a class="page-link" href="#">1</a></li><li class="page-item disabled"><a class="page-link" href="#">›</a></li></ul></nav></div>
</section>
