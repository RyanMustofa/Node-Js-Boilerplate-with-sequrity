<section class="page-heading">
  <div><h1>Good afternoon, <%= user.name.split(" ")[0] %> <span aria-hidden="true">👋</span></h1><p>Berikut ringkasan aktivitas pembayaran hari ini.</p></div>
  <span class="badge rounded-pill text-bg-light border px-3 py-2"><i class="bi bi-calendar3 me-2"></i>4 November 2026</span>
</section>
<section class="row g-3 mb-4">
  <div class="col-12 col-sm-6 col-xl-3"><article class="stat-card"><div class="d-flex justify-content-between align-items-start"><span class="small text-muted-custom">Total transaksi</span><span class="stat-icon text-primary bg-primary-subtle"><i class="bi bi-arrow-left-right"></i></span></div><div class="stat-value"><%= summary.totalTransactions %></div><div class="stat-foot"><span class="text-success fw-semibold"><i class="bi bi-arrow-up-short"></i> 8,2%</span> dari bulan lalu</div></article></div>
  <div class="col-12 col-sm-6 col-xl-3"><article class="stat-card"><div class="d-flex justify-content-between align-items-start"><span class="small text-muted-custom">Volume transaksi</span><span class="stat-icon text-success bg-success-subtle"><i class="bi bi-wallet2"></i></span></div><div class="stat-value"><%= summary.transactionVolume %></div><div class="stat-foot"><span class="text-success fw-semibold"><i class="bi bi-arrow-up-short"></i> 12,5%</span> dari bulan lalu</div></article></div>
  <div class="col-12 col-sm-6 col-xl-3"><article class="stat-card"><div class="d-flex justify-content-between align-items-start"><span class="small text-muted-custom">Payout berhasil</span><span class="stat-icon text-info bg-info-subtle"><i class="bi bi-check2-circle"></i></span></div><div class="stat-value"><%= summary.successfulPayouts %></div><div class="stat-foot"><span class="text-success fw-semibold"><i class="bi bi-arrow-up-short"></i> 4,6%</span> dari bulan lalu</div></article></div>
  <div class="col-12 col-sm-6 col-xl-3"><article class="stat-card"><div class="d-flex justify-content-between align-items-start"><span class="small text-muted-custom">Payout menunggu</span><span class="stat-icon text-warning bg-warning-subtle"><i class="bi bi-hourglass-split"></i></span></div><div class="stat-value"><%= summary.pendingPayouts %></div><div class="stat-foot">Perlu ditinjau hari ini</div></article></div>
</section>
<section class="row g-3 mb-4">
  <div class="col-xl-8"><article class="panel"><div class="panel-header"><div><h2>Ringkasan transaksi</h2><span class="small text-muted-custom">Performa transaksi minggu ini</span></div><button class="btn btn-sm btn-light border"><i class="bi bi-calendar3 me-2"></i>7 hari terakhir</button></div><div class="panel-body"><div class="d-flex align-items-end justify-content-between mb-3"><div><span class="h3 fw-bold">Rp 48.295.000</span><span class="small text-success ms-2"><i class="bi bi-arrow-up-right"></i> 14,8%</span></div><span class="small text-muted-custom">Dibanding minggu lalu</span></div><div class="d-flex align-items-end gap-3 chart-area"><% const chart = [{day:"Sen", value:48}, {day:"Sel", value:70}, {day:"Rab", value:57}, {day:"Kam", value:88}, {day:"Jum", value:66}, {day:"Sab", value:100}, {day:"Min", value:77}]; %><% chart.forEach((item, index) => { %><div class="d-flex flex-column align-items-center justify-content-end gap-2 flex-fill h-100"><div class="chart-bar rounded-top <%= index === 5 ? 'bg-primary' : 'bg-primary-subtle' %> chart-height-<%= item.value %>"></div><span class="small text-muted-custom"><%= item.day %></span></div><% }) %></div></div></article></div>
  <div class="col-xl-4"><article class="panel"><div class="panel-header"><h2>Status transaksi</h2><button class="btn btn-sm btn-light border">Hari ini</button></div><div class="panel-body"><div class="d-flex justify-content-between mb-2"><span class="small">Berhasil</span><strong class="small">78%</strong></div><div class="mini-bar mb-3"><span class="bar-width-78"></span></div><div class="d-flex justify-content-between mb-2"><span class="small">Diproses</span><strong class="small">14%</strong></div><div class="mini-bar mb-3"><span class="bar-width-14 bar-warning"></span></div><div class="d-flex justify-content-between mb-2"><span class="small">Gagal / dibatalkan</span><strong class="small">8%</strong></div><div class="mini-bar"><span class="bar-width-8 bar-danger"></span></div><div class="border-top mt-4 pt-3 d-flex justify-content-between small"><span class="text-muted-custom">Total hari ini</span><strong>1.284 transaksi</strong></div></div></article></div>
</section>
<section class="row g-3">
  <div class="col-xl-7"><article class="panel"><div class="panel-header"><div><h2>Transaksi terbaru</h2><span class="small text-muted-custom">Aktivitas pembayaran terkini</span></div><a class="btn btn-sm btn-outline-primary" href="/bo/transactions">Lihat semua</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Transaksi</th><th>Pelanggan</th><th>Nominal</th><th>Status</th></tr></thead><tbody><% transactions.forEach((item) => { %><tr><td><span class="fw-semibold text-dark"><%= item.id %></span><div class="small text-muted-custom"><%= item.createdAt %></div></td><td><%= item.customer %></td><td class="fw-semibold text-dark"><%= item.amountDisplay %></td><td><span class="badge-soft bg-<%= item.statusClass %>-subtle text-<%= item.statusClass %>-emphasis"><%= item.status %></span></td></tr><% }) %></tbody></table></div></article></div>
  <div class="col-xl-5"><article class="panel"><div class="panel-header"><div><h2>Payout terbaru</h2><span class="small text-muted-custom">Status pencairan dana</span></div><a class="btn btn-sm btn-outline-primary" href="/bo/payouts">Lihat semua</a></div><div class="panel-body"><% payouts.forEach((item) => { %><div class="activity-row"><span class="activity-icon text-<%= item.statusClass %> bg-<%= item.statusClass %>-subtle"><i class="bi bi-send"></i></span><div class="flex-grow-1 min-w-0"><div class="d-flex justify-content-between gap-2"><strong class="text-dark"><%= item.amountDisplay %></strong><span class="badge-soft bg-<%= item.statusClass %>-subtle text-<%= item.statusClass %>-emphasis"><%= item.status %></span></div><div class="small text-muted-custom text-truncate"><%= item.referenceId %> · <%= item.createdAt %></div></div></div><% }) %></div></article></div>
</section>
