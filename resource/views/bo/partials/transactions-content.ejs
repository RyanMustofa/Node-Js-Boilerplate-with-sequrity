<section class="page-heading"><div><h1>Transactions</h1><p>Pantau seluruh pembayaran yang masuk.</p></div><button class="btn btn-primary"><i class="bi bi-download me-2"></i>Export</button></section>
<section class="panel">
  <div class="panel-header flex-wrap gap-3"><div><h2>Semua transaksi</h2><span class="small text-muted-custom"><%= transactions.length %> transaksi terbaru · data demo</span></div><div class="d-flex flex-wrap gap-2"><div class="input-group search-control"><span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-secondary"></i></span><input class="form-control border-start-0" type="search" placeholder="Cari transaksi..." aria-label="Cari transaksi"></div><select class="form-select status-filter" aria-label="Filter status"><option>Semua status</option><option>Berhasil</option><option>Menunggu</option><option>Diproses</option><option>Gagal</option></select></div></div>
  <div class="table-responsive"><table class="table"><thead><tr><th>ID transaksi</th><th>Pelanggan</th><th>Metode</th><th>Waktu</th><th>Nominal</th><th>Status</th></tr></thead><tbody><% transactions.forEach((item) => { %><tr><td><span class="fw-semibold text-dark"><%= item.id %></span></td><td><span class="fw-medium text-dark"><%= item.customer %></span><div class="small text-muted-custom"><%= item.email %></div></td><td><i class="bi bi-credit-card me-2 text-muted-custom"></i><%= item.method %></td><td><%= item.createdAt %></td><td class="fw-semibold text-dark"><%= item.amountDisplay %></td><td><span class="badge-soft bg-<%= item.statusClass %>-subtle text-<%= item.statusClass %>-emphasis"><%= item.status %></span></td></tr><% }) %></tbody></table></div>
  <div class="d-flex justify-content-between align-items-center px-3 py-3 border-top"><span class="small text-muted-custom">Menampilkan <%= transactions.length %> data demo</span><nav aria-label="Navigasi halaman"><ul class="pagination pagination-sm mb-0"><li class="page-item disabled"><a class="page-link" href="#" tabindex="-1">‹</a></li><li class="page-item active"><a class="page-link" href="#">1</a></li><li class="page-item disabled"><a class="page-link" href="#">›</a></li></ul></nav></div>
</section>
