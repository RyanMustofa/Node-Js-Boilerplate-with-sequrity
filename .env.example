NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=change_me
DB_SSL=false

REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=3600s

API_MASTER_KEY=replace_with_api_master_key
API_SIGNATURE_SECRET=replace_with_signature_secret
PAYOUT_API_KEY=replace_with_payout_api_key
PAYOUT_SIGNATURE_SECRET=replace_with_payout_signature_secret

TRUST_PROXY=1

ENCRYPTION_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# For local dev, a 32-byte key is recommended. Example: 32 bytes base64 string or 32-char plain text.
